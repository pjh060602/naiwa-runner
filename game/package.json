{
  "name": "naiwa-runner",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174 --strictPort",
    "play": "vite --port 5173 --strictPort",
    "preview:pages": "vite preview --base /naiwa-runner/ --port 4187 --strictPort",
    "verify:logic": "esbuild scripts/verify-logic.ts --bundle --format=esm --platform=node --outfile=.tmp/verify-logic.mjs --log-level=error && node .tmp/verify-logic.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}